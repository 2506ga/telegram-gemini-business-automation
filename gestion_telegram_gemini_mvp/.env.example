TELEGRAM_BOT_TOKEN=PEGAR_TOKEN_DE_BOTFATHER
GEMINI_API_KEY=PEGAR_API_KEY_DE_GOOGLE_AI_STUDIO
GEMINI_MODEL=gemini-3.8-flash

# Opcional: IDs de Telegram separados por coma.
# Si se deja vacío, cualquier persona que conozca el bot puede usarlo.
ALLOWED_TELEGRAM_USERS=

# Acceso al dashboard. Para producción, preferí DASHBOARD_PASSWORD_HASH.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=cambiar-antes-de-publicar
# DASHBOARD_PASSWORD_HASH=
SECRET_KEY=cambiar-por-un-valor-aleatorio-largo
COOKIE_SECURE=false

# En producción puede apuntar a un disco persistente, por ejemplo /var/data/gestion.db
DB_PATH=gestion.db
